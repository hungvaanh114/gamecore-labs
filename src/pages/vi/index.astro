---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PrimaryButton from '../../components/PrimaryButton.astro'; import SecondaryButton from '../../components/SecondaryButton.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import ServiceCard from '../../components/ServiceCard.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import ValueCard from '../../components/ValueCard.astro'; import CTASection from '../../components/CTASection.astro'; import EngagementCards from '../../components/EngagementCards.astro'; import { servicesVi } from '../../data/services-vi'; import { featuredProjectsVi } from '../../data/projects-vi'; import { withBase } from '../../utils/paths';
---
<BaseLayout lang="vi" title="GameCore Labs | Studio Phát Triển Game" description="GameCore Labs giúp nhà sáng tạo và doanh nghiệp phát triển game Unity, nguyên mẫu, hệ thống gameplay và trải nghiệm tương tác.">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy reveal"><p class="eyebrow">STUDIO PHÁT TRIỂN GAME ĐỘC LẬP</p><h1 class="display">Biến Ý Tưởng Game <span class="gradient-text">Thành Hiện Thực.</span></h1><p class="lede">Chúng tôi giúp nhà sáng tạo và các đội ngũ xây dựng game Unity, nguyên mẫu và hệ thống gameplay hoàn chỉnh — từ ý tưởng có thể chơi đầu tiên đến hỗ trợ sản xuất.</p><div class="hero-actions"><PrimaryButton href="/vi/contact">Bắt Đầu Dự Án</PrimaryButton><SecondaryButton href="/vi/work">Xem Dự Án</SecondaryButton></div></div><div class="hero-art"><img src={withBase('/images/hero-game.webp')} alt="Hình minh họa nhân vật game đeo tai nghe" width="960" height="720" fetchpriority="high" /><div class="art-note"><span></span><p>Từ ý tưởng<br/><strong>đến bản chơi</strong></p></div></div></div><div class="container trust-row"><div><b>Chuyên Unity</b><span>Phát triển 2D & 3D</span></div><div><b>Lặp nhanh</b><span>Nguyên mẫu có mục tiêu</span></div><div><b>Trao đổi trực tiếp</b><span>Cập nhật rõ ràng</span></div><div><b>Hỗ trợ linh hoạt</b><span>Theo phạm vi dự án</span></div></div></section>
  <section class="section services-home"><div class="container"><SectionHeading eyebrow="CHÚNG TÔI LÀM GÌ" title="Hỗ trợ phát triển cho mọi cột mốc có thể chơi." description="Một nhóm dịch vụ tập trung cho dự án Unity, từ bản chứng minh ý tưởng đến cải tiến sản phẩm."/><div class="grid-4">{servicesVi.map(service=><ServiceCard {service}/>)}</div><div class="center-action"><SecondaryButton href="/vi/services">Xem Tất Cả Dịch Vụ</SecondaryButton></div></div></section>
  <section class="section projects-home"><div class="container"><SectionHeading eyebrow="Ý TƯỞNG TIÊU BIỂU" title="Dự Án Nổi Bật" description="Các ý tưởng demo thể hiện loại trải nghiệm và hệ thống chúng tôi có thể hỗ trợ xây dựng. Đây không phải dự án khách hàng."/><div class="grid-3">{featuredProjectsVi.map(project=><ProjectCard {project} lang="vi"/>)}</div><div class="center-action"><SecondaryButton href="/vi/work">Khám Phá Tất Cả</SecondaryButton></div></div></section>
  <section class="section about-home"><div class="container about-grid"><div><p class="eyebrow">VỀ GAMECORE LABS</p><h2 class="section-title">Đội Ngũ Nhỏ.<br/>Đam Mê Lớn.</h2><p class="lede">GameCore Labs là studio phát triển game độc lập quy mô nhỏ, tập trung biến ý tưởng thành trải nghiệm game hoàn chỉnh.</p><p class="muted">Chúng tôi đồng hành cùng nhà sáng tạo và đội ngũ từ nguyên mẫu đến sản xuất.</p><SecondaryButton href="/vi/studio">Tìm Hiểu GameCore Labs</SecondaryButton></div><div class="studio-image"><img src={withBase('/images/studio.webp')} alt="Không gian studio phát triển game với hai máy trạm" width="960" height="720" loading="lazy" /></div></div></section>
  <section class="section-tight values"><div class="container"><SectionHeading eyebrow="VÌ SAO CHỌN GAMECORE LABS" title="Hợp tác thiết thực, tập trung vào sản phẩm."/><div class="grid-4"><ValueCard title="Tập Trung Vào Game" description="Quyết định luôn hướng tới trải nghiệm chơi." icon="unity"/><ValueCard title="Lặp Nhanh" description="Kiểm tra sớm những câu hỏi quan trọng." icon="spark"/><ValueCard title="Trao Đổi Trực Tiếp" description="Cập nhật rõ ràng và thảo luận hữu ích." icon="users"/><ValueCard title="Hợp Tác Linh Hoạt" description="Hỗ trợ phù hợp với từng giai đoạn dự án." icon="refresh"/></div></div></section>
  <section class="section engagement-home"><div class="container"><SectionHeading eyebrow="MÔ HÌNH HỢP TÁC" title="Cách Làm Việc Linh Hoạt" description="Chọn mô hình rõ ràng, không có gói dịch vụ hoặc giá giả định."/><EngagementCards lang="vi"/></div></section>
  <section class="section-tight"><div class="container"><SectionHeading eyebrow="CÂU CHUYỆN KHÁCH HÀNG" title="Niềm tin cần được xây dựng."/><div class="testimonial-note card"><p>Đánh giá khách hàng sẽ sớm được cập nhật.</p><span>Chúng tôi chỉ công bố phản hồi đã được xác minh và cho phép.</span></div></div></section><CTASection lang="vi"/>
</BaseLayout>
<style>.hero{position:relative;overflow:hidden;padding:clamp(3rem,7vw,6rem) 0 0}.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,10,15,.95) 0%,transparent 65%);pointer-events:none}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;min-height:610px}.hero-copy{padding:3rem 0 5rem}.hero-copy .lede{max-width:38rem;margin:1.6rem 0;color:#aeb9c8}.hero-actions{display:flex;gap:.8rem}.hero-art{position:relative;height:100%;align-self:stretch}.hero-art::after{content:"";position:absolute;inset:auto 0 0;height:28%;background:linear-gradient(transparent,#070a0f)}.hero-art img{width:100%;height:100%;object-fit:cover;object-position:center;border-radius:1rem 1rem 0 0;mask-image:linear-gradient(90deg,transparent 0%,black 16%,black 100%)}.art-note{position:absolute;z-index:2;right:1.2rem;bottom:4rem;display:flex;align-items:center;gap:.75rem;padding:.7rem 1rem;border:1px solid rgba(255,255,255,.15);border-radius:.65rem;background:rgba(7,10,15,.72);backdrop-filter:blur(12px)}.art-note span{width:.55rem;height:.55rem;border-radius:50%;background:#7c5cfc;box-shadow:0 0 16px #7c5cfc}.art-note p{margin:0;color:#a8b4c4;font-size:.72rem;line-height:1.35;text-transform:uppercase;letter-spacing:.1em}.art-note strong{color:#fff}.trust-row{position:relative;z-index:2;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.trust-row div{padding:1.2rem 1.1rem;border-right:1px solid var(--line)}.trust-row div:last-child{border:0}.trust-row b,.trust-row span{display:block}.trust-row b{font-size:.82rem}.trust-row span{color:#7f8b9d;font-size:.72rem}.services-home,.engagement-home{background:#0a0f17}.center-action{display:flex;justify-content:center;margin-top:2.3rem}.projects-home{background:radial-gradient(circle at 50% 20%,rgba(55,72,135,.12),transparent 40rem)}.about-home{background:#090e15}.about-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,6vw,6rem);align-items:center}.about-grid .lede{margin:1.3rem 0 .8rem}.about-grid .button{margin-top:1.4rem}.studio-image{position:relative}.studio-image::before{content:"";position:absolute;inset:-1px;border-radius:1rem;background:linear-gradient(135deg,#3b82f6,transparent 40%,#7c5cfc);z-index:0}.studio-image img{position:relative;z-index:1;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:1rem;padding:1px}.testimonial-note{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.6rem}.testimonial-note p{margin:0;font-size:1.2rem;font-weight:700}.testimonial-note span{color:#8996a8;font-size:.85rem}@media(max-width:900px){.hero-grid{grid-template-columns:1fr;min-height:auto}.hero-copy{padding-bottom:2rem}.hero-art{height:440px}.trust-row{grid-template-columns:repeat(2,1fr)}.trust-row div:nth-child(2){border-right:0}.about-grid{grid-template-columns:1fr}.studio-image{order:-1}}@media(max-width:560px){.hero{padding-top:1.5rem}.hero-actions{flex-direction:column}.hero-art{height:350px}.hero-art img{mask-image:linear-gradient(180deg,black 70%,transparent)}.trust-row{grid-template-columns:1fr}.trust-row div{border-right:0;border-bottom:1px solid var(--line)}.testimonial-note{align-items:flex-start;flex-direction:column}.art-note{right:.6rem;bottom:2rem}}</style>

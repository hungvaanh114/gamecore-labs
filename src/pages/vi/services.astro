---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import ServiceCard from '../../components/ServiceCard.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import EngagementCards from '../../components/EngagementCards.astro'; import CTASection from '../../components/CTASection.astro'; import { servicesVi } from '../../data/services-vi';
---
<BaseLayout lang="vi" title="Dịch Vụ Phát Triển Game | GameCore Labs" description="Phát triển Unity, làm nguyên mẫu, lập trình gameplay, tối ưu và hỗ trợ phát triển game dài hạn."><PageHero eyebrow="DỊCH VỤ" title="Mọi Thứ Bạn Cần Để Xây Dựng Một Game Hay" description="Từ nguyên mẫu đến sản xuất, GameCore Labs cung cấp dịch vụ phát triển game phù hợp với dự án của bạn."/><section class="section-tight"><div class="container services-grid">{servicesVi.map(service=><ServiceCard {service} detailed/>)}</div></section><section class="section"><div class="container"><SectionHeading eyebrow="MÔ HÌNH HỢP TÁC" title="Cách làm việc rõ ràng." description="Chọn cấu trúc phù hợp với phạm vi, tốc độ và giai đoạn hiện tại của dự án."/><EngagementCards lang="vi"/></div></section><section class="section-tight tech"><div class="container"><SectionHeading eyebrow="CÔNG NGHỆ" title="Bộ công cụ tập trung và thiết thực."/><div class="tech-list">{['Unity','C#','Git','GitHub','GitLab','Blender','WebGL','Photoshop','Aseprite'].map(item=><span>{item}</span>)}</div></div></section><CTASection lang="vi"/></BaseLayout>
<style>.services-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem}.tech{background:#0a0f17}.tech-list{display:flex;flex-wrap:wrap;gap:.7rem}.tech-list span{padding:.7rem 1rem;border:1px solid var(--line);border-radius:.55rem;background:#101721;color:#cbd4df;font-weight:650;font-size:.88rem}@media(max-width:700px){.services-grid{grid-template-columns:1fr}}</style>

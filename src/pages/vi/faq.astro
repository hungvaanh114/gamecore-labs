import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import FAQItem from '../../components/FAQItem.astro'; import CTASection from '../../components/CTASection.astro';
const faqs=[['Một dự án thường mất bao lâu?','Thời gian phụ thuộc vào phạm vi và mức độ sẵn sàng. Nguyên mẫu tập trung có thể mất vài tuần, còn sản phẩm lớn hơn sẽ được chia theo cột mốc. Chúng tôi xem brief trước khi đề xuất tiến độ thực tế.'],['Chi phí dự án là bao nhiêu?','Chi phí phụ thuộc vào phạm vi, độ phức tạp và mô hình hợp tác. Chúng tôi không đưa giá chung vì cùng một tính năng có thể cần mức hoàn thiện và tích hợp rất khác nhau.'],['Có thể làm việc với dự án Unity hiện có không?','Có. Trước tiên chúng tôi xem cấu trúc dự án, phiên bản Unity, trạng thái build và thay đổi cần thực hiện để xác định phạm vi an toàn.'],['Có thể làm nguyên mẫu game không?','Có. Nguyên mẫu là một dịch vụ cốt lõi, có thể tập trung vào cơ chế, bản chứng minh ý tưởng, MVP hoặc vertical slice.'],['Có thể sửa lỗi hoặc tối ưu game hiện có không?','Có. Chúng tôi có thể điều tra lỗi gameplay, hiệu năng, bộ nhớ và khả năng bảo trì mã nguồn. Thường sẽ có bước đánh giá trước khi triển khai.'],['Phát triển cho nền tảng nào?','Chúng tôi tập trung vào dự án Unity cho di động, PC và WebGL, tùy yêu cầu kỹ thuật cụ thể.'],['Có thể hợp tác dài hạn không?','Có. Mô hình hợp tác dài hạn có thể bao gồm bảo trì, phát triển tính năng và cải tiến liên tục sau khi thống nhất phạm vi ban đầu.'],['Có ký NDA không?','Có. Chúng tôi có thể xem xét và ký NDA hợp lý trước khi nhận tài liệu dự án bảo mật.']];

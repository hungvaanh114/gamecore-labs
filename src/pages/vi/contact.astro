---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import ContactFormVi from '../../components/ContactFormVi.astro'; import { siteConfig } from '../../config/site';
---
<BaseLayout lang="vi" title="Bắt Đầu Dự Án | GameCore Labs" description="Chia sẻ nhu cầu phát triển game, nguyên mẫu, gameplay hoặc hỗ trợ Unity với GameCore Labs."><PageHero eyebrow="LIÊN HỆ" title="Cùng Nhau Tạo Nên Một Trò Chơi Tuyệt Vời." description="Bạn có ý tưởng game hoặc dự án đang cần hỗ trợ phát triển? Hãy chia sẻ để chúng tôi xem có thể giúp gì." compact/><section class="section-tight"><div class="container contact-grid"><ContactFormVi/><aside><p class="eyebrow">CÁCH LIÊN HỆ KHÁC</p><h2>Hãy bắt đầu với những gì bạn đã biết.</h2><p>Bạn không cần một tài liệu hoàn hảo. Chỉ cần mô tả ngắn, trạng thái hiện tại và kết quả mong muốn.</p><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a><dl><div><dt>Địa điểm</dt><dd>Hà Nội, Việt Nam (GMT+7)</dd></div><div><dt>Hình thức</dt><dd>Hợp tác từ xa trên toàn thế giới</dd></div></dl><div class="brief card"><span>01</span><p><b>Ý tưởng hoặc vấn đề</b><br/>Bạn đang muốn xây dựng hoặc cải thiện điều gì?</p><span>02</span><p><b>Giai đoạn hiện tại</b><br/>Ý tưởng, nguyên mẫu hay đang sản xuất?</p><span>03</span><p><b>Thông tin hữu ích</b><br/>Nền tảng, thời gian và ưu tiên.</p></div></aside></div></section></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(2rem,5vw,4rem);align-items:start}aside{padding-top:.4rem}aside h2{margin:.3rem 0;font-size:1.7rem}aside>p:not(.eyebrow){color:#9ca8b8}aside>a{display:inline-block;margin:.6rem 0 1.5rem;color:#bdcaff;font-weight:650}dl{display:grid;gap:.9rem;margin-bottom:1.5rem}dt{color:#707d8f;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em}dd{margin:.1rem 0 0;color:#d6dee9;font-size:.9rem}.brief{display:grid;grid-template-columns:auto 1fr;gap:.9rem;padding:1.2rem}.brief span{color:#8f7cff;font-weight:800;font-size:.75rem}.brief p{margin:0;color:#9ca8b8;font-size:.84rem}.brief b{color:#e7ebf2}@media(max-width:850px){.contact-grid{grid-template-columns:1fr}}</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import ValueCard from '../../components/ValueCard.astro'; import ProcessStep from '../../components/ProcessStep.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import CTASection from '../../components/CTASection.astro'; import { withBase } from '../../utils/paths';
---
<BaseLayout lang="vi" title="Studio | GameCore Labs" description="Tìm hiểu GameCore Labs, studio độc lập tập trung xây dựng trải nghiệm game hoàn chỉnh và hấp dẫn."><PageHero eyebrow="VỀ GAMECORE LABS" title="Đội Ngũ Nhỏ Với Đam Mê Lớn" description="GameCore Labs là studio phát triển game độc lập tập trung xây dựng những trải nghiệm game hoàn chỉnh và hấp dẫn."/><section class="section-tight"><div class="container intro"><img src={withBase('/images/studio.webp')} alt="Không gian phát triển game GameCore Labs" width="1280" height="768"/><div><p class="eyebrow">STUDIO CỦA CHÚNG TÔI</p><h2 class="section-title">Sản xuất game thiết thực, phối hợp chặt chẽ.</h2><p class="lede">Chúng tôi kết hợp phát triển kỹ thuật với quy trình sản xuất thực tế để biến ý tưởng thành sản phẩm có thể chơi.</p><p class="muted">Cấu trúc nhỏ gọn giúp trao đổi tập trung, chịu trách nhiệm kỹ thuật trực tiếp và linh hoạt khi dự án dần rõ ràng hơn.</p></div></div></section><section class="section values"><div class="container"><SectionHeading eyebrow="GIÁ TRỊ" title="Cách chúng tôi thực hiện công việc."/><div class="grid-4"><ValueCard title="Chất Lượng" description="Chúng tôi quan tâm đến từng chi tiết."/><ValueCard title="Tin Cậy" description="Kỳ vọng rõ ràng và bàn giao đúng cam kết." icon="shield"/><ValueCard title="Hợp Tác" description="Chúng tôi làm việc sát sao với khách hàng." icon="users"/><ValueCard title="Sáng Tạo" description="Giải quyết vấn đề bằng tư duy sáng tạo thiết thực." icon="spark"/></div></div></section><section class="section"><div class="container"><SectionHeading eyebrow="QUY TRÌNH" title="Con đường rõ ràng từ ý tưởng đến bàn giao."/><div class="grid-4"><ProcessStep number="01" title="Khám Phá" description="Hiểu ý tưởng, yêu cầu và mục tiêu dự án."/><ProcessStep number="02" title="Lên Kế Hoạch" description="Xác định phạm vi, cột mốc và cách tiếp cận kỹ thuật."/><ProcessStep number="03" title="Xây Dựng" description="Phát triển, kiểm thử và lặp."/><ProcessStep number="04" title="Bàn Giao" description="Hoàn thiện, bàn giao và hỗ trợ."/></div></div></section><section class="section-tight capabilities"><div class="container"><SectionHeading eyebrow="NĂNG LỰC" title="Năng lực đội ngũ, không tạo nhân sự giả."/><div class="grid-4">{[['Phát Triển','Hệ thống và triển khai Unity'],['Thiết Kế Game','Cơ chế và luồng chơi'],['Tích Hợp Mỹ Thuật','Asset, scene và giao diện'],['Kiểm Thử & Hỗ Trợ','Lặp, sửa lỗi và hỗ trợ sản xuất']].map(([title,text])=><article class="card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section><CTASection lang="vi"/></BaseLayout>
<style>.intro{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,6vw,5rem);align-items:center}.intro img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:1rem;border:1px solid var(--line)}.intro .lede{margin:1.2rem 0}.values,.capabilities{background:#0a0f17}.capabilities article{padding:1.4rem}.capabilities h3{margin:0 0 .35rem}.capabilities p{margin:0;color:#919dad;font-size:.88rem}@media(max-width:820px){.intro{grid-template-columns:1fr}}</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EmptyTestimonials from '../../components/EmptyTestimonials.astro';
import CTASection from '../../components/CTASection.astro';
import { testimonials } from '../../data/testimonials';
---
<BaseLayout lang="vi" title="Câu Chuyện Khách Hàng | GameCore Labs" description="Phản hồi đã được xác minh từ khách hàng của GameCore Labs.">
  <PageHero eyebrow="ĐÁNH GIÁ" title="Khách Hàng Nói Gì" description="Phản hồi thực tế chỉ được đăng sau khi khách hàng đồng ý công khai." compact />
  <section class="section-tight"><div class="container">{testimonials.length === 0 ? <EmptyTestimonials lang="vi" /> : <div class="grid-3">{testimonials.map(item => <blockquote class="card"><p>“{item.quote}”</p><footer>{item.name}{item.role && <span>{item.role}</span>}</footer></blockquote>)}</div>}</div></section>
  <CTASection lang="vi" />
</BaseLayout>
<style>blockquote{margin:0;padding:1.5rem}blockquote p{font-size:1.05rem}blockquote footer{font-weight:700}blockquote span{display:block;color:#8d99aa;font-size:.82rem;font-weight:400}</style>

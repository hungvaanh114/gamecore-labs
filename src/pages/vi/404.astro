---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrimaryButton from '../../components/PrimaryButton.astro';
import { withBase } from '../../utils/paths';
---
<BaseLayout lang="vi" title="Không Tìm Thấy Trang | GameCore Labs" noindex>
  <section class="not-found"><img src={withBase('/images/project-shadow.webp')} alt="Tàn tích khoa học viễn tưởng bí ẩn" /><div class="content"><span>404</span><h1>Không Tìm Thấy Trang</h1><p>Có vẻ màn chơi này không tồn tại.</p><PrimaryButton href="/vi/">Về Trang Chủ</PrimaryButton></div></section>
</BaseLayout>
<style>.not-found{position:relative;display:grid;place-items:center;min-height:72vh;text-align:center;overflow:hidden}.not-found::after{content:"";position:absolute;inset:0;background:linear-gradient(rgba(7,10,15,.42),#070a0f)}.not-found>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}.content{position:relative;z-index:1;padding:3rem}.content>span{font-size:clamp(6rem,18vw,13rem);line-height:.8;font-weight:850;letter-spacing:-.08em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.5);text-shadow:0 0 50px rgba(105,77,238,.35)}h1{font-size:clamp(2rem,5vw,3.8rem);margin:1.5rem 0 .3rem}p{color:#b7c1cf;margin:0 0 1.5rem}</style>

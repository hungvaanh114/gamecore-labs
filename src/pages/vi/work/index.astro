---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import PageHero from '../../../components/PageHero.astro'; import ProjectCard from '../../../components/ProjectCard.astro'; import CTASection from '../../../components/CTASection.astro'; import { projectsVi } from '../../../data/projects-vi';
const filters=['Tất cả','Di động','PC','WebGL','Nguyên mẫu','2D','3D'];
---
<BaseLayout lang="vi" title="Dự Án & Ý Tưởng Demo | GameCore Labs" description="Khám phá các ý tưởng demo và cấu trúc dự án mẫu của GameCore Labs."><PageHero eyebrow="DỰ ÁN" title="Dự Án Nổi Bật" description="Tuyển tập ý tưởng game và dự án tương tác. Tất cả mục hiện tại đều được ghi rõ là demo, không phải dự án khách hàng." compact/><section class="section-tight"><div class="container"><div class="filters" role="group" aria-label="Lọc dự án">{filters.map((filter,i)=><button type="button" class:list={[{active:i===0}]} data-filter={filter} aria-pressed={i===0?'true':'false'}>{filter}</button>)}</div><div class="grid-3 project-grid">{projectsVi.map(project=><ProjectCard {project} lang="vi"/>)}</div><p class="no-results" data-no-results hidden>Không có ý tưởng nào phù hợp với bộ lọc này.</p></div></section><CTASection lang="vi" title="Bạn Có Một Dự Án Tương Tự?" text="Hãy cho chúng tôi biết trải nghiệm bạn muốn tạo và phần việc đang cần hỗ trợ."/></BaseLayout>
<script>const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];const cards=[...document.querySelectorAll<HTMLElement>('[data-project]')];const empty=document.querySelector<HTMLElement>('[data-no-results]');buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter||'Tất cả';buttons.forEach(b=>{const on=b===button;b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on));});let count=0;cards.forEach(card=>{const show=filter==='Tất cả'||(card.dataset.filters||'').includes(filter);card.hidden=!show;if(show)count++;});if(empty)empty.hidden=count!==0;}));</script>
<style>.filters{display:flex;flex-wrap:wrap;justify-content:center;gap:.55rem;margin-bottom:2rem}.filters button{padding:.5rem .85rem;border:1px solid var(--line);border-radius:.48rem;background:#0d141f;color:#9da9b9;font-size:.8rem;font-weight:650;cursor:pointer}.filters button:hover,.filters button.active{background:#f3f5f9;color:#0a0f17}.no-results{text-align:center;color:#9ca8b8;padding:3rem}</style>

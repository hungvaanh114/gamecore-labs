---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PrimaryButton from '../../components/PrimaryButton.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import { projects, type Project } from '../../data/projects'; import { withBase } from '../../utils/paths';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const { project } = Astro.props as {project:Project}; const related=projects.filter(p=>p.slug!==project.slug).slice(0,3);
---
<BaseLayout title={`${project.title} | GameCore Labs`} description={project.description} image={project.coverImage}>
  <section class="case-hero"><div class="container"><a class="back" href={withBase('/work/')}>← Back to Projects</a><div class="case-grid"><div><span class="tag">{project.status}</span><h1 class="page-title">{project.title}</h1><p class="lede">{project.description}</p><dl><div><dt>Platform</dt><dd>{project.platform.join(' / ')}</dd></div><div><dt>Genre</dt><dd>{project.genre}</dd></div><div><dt>Development Scope</dt><dd>{project.services.join(', ')}</dd></div><div><dt>Technology</dt><dd>{project.technology.join(', ')}</dd></div></dl></div><img src={withBase(project.coverImage)} alt={`${project.title} demo project artwork`} width="960" height="600" /></div></div></section>
  <section class="gallery" aria-label={`${project.title} gallery`}><div class="container gallery-grid">{project.gallery.map((image,index)=><img src={withBase(image)} alt={`${project.title} concept detail ${index+1}`} width="800" height="500" loading="lazy" />)}</div></section>
  <section class="section-tight"><div class="container case-content"><div><p class="eyebrow">PROJECT BREAKDOWN</p><h2>The Challenge</h2><p>{project.challenge}</p><h2>Our Approach</h2><p>{project.approach}</p><h2>What We Built</h2><p>{project.built}</p></div><aside class="card"><h2>Key Features</h2><ul class="list-check">{project.features.map(x=><li>{x}</li>)}</ul><h2>Technical Work</h2><ul class="list-check">{project.technicalWork.map(x=><li>{x}</li>)}</ul></aside><div class="outcome card"><p class="eyebrow">OUTCOME</p><p>{project.outcome}</p><div>{project.technology.map(x=><span class="tag">{x}</span>)}</div></div></div></section>
  <section class="section related"><div class="container"><SectionHeading eyebrow="KEEP EXPLORING" title="Related Projects"/><div class="grid-3">{related.map(project=><ProjectCard {project}/>)}</div></div></section>
  <section class="section-tight"><div class="container case-cta"><div><p class="eyebrow">START A CONVERSATION</p><h2>Have a Similar Project?</h2><p>Share the idea, the current build or the problem you need to solve.</p></div><PrimaryButton href="/contact">Let's Talk</PrimaryButton></div></section>
</BaseLayout>
<style>.case-hero{padding:3rem 0 4rem}.back{display:inline-block;margin-bottom:2rem;color:#aab5c4;font-size:.86rem}.case-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(2rem,6vw,5rem);align-items:center}.case-grid h1{margin:.8rem 0}.case-grid img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:1rem;border:1px solid var(--line)}.gallery{padding-bottom:2rem}.gallery-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:.8rem}.gallery img{width:100%;height:220px;object-fit:cover;border:1px solid var(--line);border-radius:.75rem}.gallery img:first-child{height:100%}dl{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:2rem 0 0}dt{color:#748094;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em}dd{margin:.15rem 0 0;font-size:.86rem;color:#d9e0e9}.case-content{display:grid;grid-template-columns:1.2fr .8fr;gap:2rem}.case-content h2{font-size:1.25rem;margin:2rem 0 .45rem}.case-content>div>h2:first-of-type{margin-top:1rem}.case-content p{color:#a8b3c2}.case-content aside{padding:1.6rem;align-self:start}.case-content aside h2:first-child{margin-top:0}.outcome{grid-column:1/-1;padding:1.7rem}.outcome>p:nth-child(2){font-size:1.1rem;color:#dce2eb;max-width:55rem}.outcome>div{display:flex;gap:.5rem;flex-wrap:wrap}.related{background:#0a0f17}.case-cta{display:flex;align-items:end;justify-content:space-between;gap:2rem}.case-cta h2{margin:0;font-size:clamp(2rem,4vw,3rem)}.case-cta p:last-child{color:#9ca8b8}@media(max-width:820px){.case-grid,.case-content{grid-template-columns:1fr}.gallery-grid{grid-template-columns:1fr 1fr}.gallery img:first-child{grid-column:1/-1;height:280px}.case-cta{align-items:stretch;flex-direction:column}}@media(max-width:500px){dl,.gallery-grid{grid-template-columns:1fr}.gallery img:first-child{grid-column:auto;height:220px}}</style>

---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import ValueCard from '../components/ValueCard.astro'; import ProcessStep from '../components/ProcessStep.astro'; import SectionHeading from '../components/SectionHeading.astro'; import CTASection from '../components/CTASection.astro'; import { withBase } from '../utils/paths';
---
<BaseLayout title="Studio | GameCore Labs" description="Meet GameCore Labs, an independent studio focused on polished, engaging game experiences.">
  <PageHero eyebrow="ABOUT GAMECORE LABS" title="A Small Team With a Big Passion" description="GameCore Labs is an independent game development studio focused on building polished, engaging game experiences." />
  <section class="section-tight"><div class="container intro"><img src={withBase('/images/studio.webp')} alt="GameCore Labs game development workspace" width="1280" height="768" /><div><p class="eyebrow">OUR STUDIO</p><h2 class="section-title">Practical game production, closely connected.</h2><p class="lede">We combine technical development with practical game production to help turn ideas into playable products.</p><p class="muted">Our structure stays intentionally small: focused conversations, direct technical ownership and room to adapt as the project becomes clearer.</p></div></div></section>
  <section class="section values"><div class="container"><SectionHeading eyebrow="OUR VALUES" title="How we show up for the work."/><div class="grid-4"><ValueCard title="Quality" description="We care about the details."/><ValueCard title="Reliability" description="Clear expectations and dependable delivery." icon="shield"/><ValueCard title="Collaboration" description="We work closely with our clients." icon="users"/><ValueCard title="Creativity" description="We solve problems with practical creative thinking." icon="spark"/></div></div></section>
  <section class="section"><div class="container"><SectionHeading eyebrow="HOW WE WORK" title="A clear path from idea to delivery."/><div class="grid-4"><ProcessStep number="01" title="Discover" description="Understand the idea, requirements and project goals."/><ProcessStep number="02" title="Plan" description="Define scope, milestones and technical approach."/><ProcessStep number="03" title="Build" description="Develop, test and iterate."/><ProcessStep number="04" title="Deliver" description="Polish, deliver and support the project."/></div></div></section>
  <section class="section-tight capabilities"><div class="container"><SectionHeading eyebrow="CAPABILITIES" title="A team view without invented team members."/><div class="grid-4">{[['Development','Unity systems and implementation'],['Game Design','Mechanics and playable flows'],['Art Integration','Assets, scenes and UI implementation'],['Testing & Support','Iteration, fixes and production help']].map(([title,text])=><article class="card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section><CTASection />
</BaseLayout>
<style>.intro{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,6vw,5rem);align-items:center}.intro img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:1rem;border:1px solid var(--line)}.intro .lede{margin:1.2rem 0}.values,.capabilities{background:#0a0f17}.capabilities article{padding:1.4rem}.capabilities h3{margin:0 0 .35rem}.capabilities p{margin:0;color:#919dad;font-size:.88rem}@media(max-width:820px){.intro{grid-template-columns:1fr}}</style>

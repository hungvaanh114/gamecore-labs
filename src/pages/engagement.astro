---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import EngagementCards from '../components/EngagementCards.astro'; import CTASection from '../components/CTASection.astro';
const detail=[['Fixed Scope','For a defined feature, build or milestone. We confirm requirements, deliverables and acceptance criteria before development begins.','Predictable scope, shared expectations and a clear completion point.','Feature implementation, a small game, a defined reskin or a focused optimization pass.'],['Dedicated Sprint','For a concentrated period of development where priorities may evolve as the build is tested.','Fast feedback, flexible priorities and visible progress through iteration.','Prototype development, vertical slices, gameplay exploration or production pushes.'],['Retainer','For teams that need recurring development capacity after the working rhythm is established.','Continuity, retained project context and room for ongoing improvements.','Maintenance, regular feature work, bug fixing and technical support.']];
---
<BaseLayout title="Engagement Models | GameCore Labs"><PageHero eyebrow="ENGAGEMENT MODELS" title="Flexible Ways to Work Together" description="A clear collaboration model for defined work, fast iteration or ongoing development."/><section class="section-tight"><div class="container"><EngagementCards/></div></section><section class="section details"><div class="container detail-list">{detail.map(([title,how,advantages,uses],i)=><article><span>0{i+1}</span><div><h2>{title}</h2><h3>How it works</h3><p>{how}</p><h3>Advantages</h3><p>{advantages}</p><h3>Typical use cases</h3><p>{uses}</p></div></article>)}</div></section><CTASection title="Tell Us About Your Project" text="We’ll help you choose the model that fits the work — no invented packages or unnecessary commitments."/></BaseLayout>
<style>.details{background:#0a0f17}.detail-list{display:grid;gap:1rem}.detail-list article{display:grid;grid-template-columns:5rem 1fr;gap:1rem;padding:1.6rem;border-top:1px solid var(--line)}.detail-list article>span{color:#7963ed;font-size:1.8rem;font-weight:800}.detail-list h2{margin:0 0 1rem;font-size:1.6rem}.detail-list h3{margin:1rem 0 .25rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.12em;color:#c4ceff}.detail-list p{margin:0;color:#9ca8b8}@media(max-width:600px){.detail-list article{grid-template-columns:1fr}.detail-list article>span{font-size:1rem}}</style>

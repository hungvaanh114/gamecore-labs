---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { firebaseConfigured } from '../../lib/firebase';
import { withBase } from '../../utils/paths';
---
<AdminLayout>
  <section class="login-shell" data-login-shell>
    <form class="login-card card" data-login-form>
      <a class="back" href={withBase('/vi/')}>← Về website</a><div class="mark">G</div><p class="eyebrow">GAMECORE LABS</p><h1>Đăng nhập quản trị</h1><p class="muted">Quản lý sản phẩm, nội dung và dữ liệu tương tác.</p>
      <label>Tài khoản<input name="username" autocomplete="username" required placeholder="admin" /></label><label>Mật khẩu<input name="password" type="password" autocomplete="current-password" required /></label>
      <button class="button button-primary" type="submit">Đăng nhập</button><p class="status" data-login-status role="status"></p>
    </form>
  </section>
  <section class="admin-shell" data-admin-shell hidden data-configured={String(firebaseConfigured)}>
    <aside><div><b>GameCore Labs</b><span>Admin Console</span></div><nav><button class="active" data-tab="overview">Tổng quan</button><button data-tab="products">Sản phẩm</button><button data-tab="comments">Bình luận</button><button data-tab="inquiries">Khách liên hệ</button></nav><button class="signout" data-signout>Đăng xuất</button></aside>
    <div class="workspace"><header><div><p class="eyebrow">QUẢN TRỊ WEBSITE</p><h1 data-section-title>Tổng quan</h1></div><a href={withBase('/vi/')} target="_blank">Xem website ↗</a></header>
      <p class="notice" data-admin-notice hidden></p>
      <section class="panel active" data-panel="overview"><div class="metric-grid"><article><span>Sản phẩm</span><strong data-total-products>0</strong></article><article><span>Lượt xem</span><strong data-total-views>0</strong></article><article><span>Lượt click</span><strong data-total-clicks>0</strong></article><article><span>Liên hệ mới</span><strong data-total-inquiries>0</strong></article></div><div class="card activity"><h2>Hiệu quả sản phẩm</h2><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Lượt xem</th><th>Click</th><th>Tỷ lệ click</th></tr></thead><tbody data-stats-table></tbody></table></div></div></section>
      <section class="panel" data-panel="products"><div class="panel-head"><div><h2>Danh sách sản phẩm</h2><p>Thêm, chỉnh sửa giá, nội dung và ảnh hiển thị.</p></div><button class="button button-primary" data-new-product>+ Thêm sản phẩm</button></div><form class="editor card" data-product-form hidden><input type="hidden" name="id"/><div class="field-grid"><label>Tên sản phẩm<input name="title" required/></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label></div><div class="field-grid"><label>Giá<input name="price" type="number" min="0" step="0.01" required/></label><label>Tiền tệ<select name="currency"><option>VND</option><option>USD</option></select></label></div><div class="field-grid"><label>Thể loại game<input name="category" placeholder="Hành động, Kinh dị…"/></label><label>Game tham khảo<input name="referenceGame" placeholder="Tên game hoặc sản phẩm tương tự"/></label></div><label>Thứ tự hiển thị<input name="order" type="number" value="0"/></label><label>Mô tả<textarea name="description" rows="4" required></textarea></label><div class="field-grid"><label>Ảnh sản phẩm<input name="image" type="file" accept="image/*"/></label><label>Hoặc URL ảnh<input name="imageUrl" type="url"/></label></div><div class="field-grid"><label>Nhãn nút<input name="ctaLabel" value="Xem chi tiết"/></label><label>Link nút<input name="ctaUrl" type="url"/></label></div><label class="check"><input name="published" type="checkbox"/> Công khai sản phẩm</label><div class="form-actions"><button class="button" type="button" data-cancel-product>Hủy</button><button class="button button-primary" type="submit">Lưu sản phẩm</button></div><p class="status" data-product-status></p></form><div class="table-wrap card"><table><thead><tr><th>Sản phẩm</th><th>Giá</th><th>Trạng thái</th><th></th></tr></thead><tbody data-product-table></tbody></table></div></section>
      <section class="panel" data-panel="comments"><div class="panel-head"><div><h2>Bình luận</h2><p>Thêm và quản lý nội dung hiển thị.</p></div><button class="button button-primary" data-new-comment>+ Thêm bình luận</button></div><form class="editor card" data-comment-form hidden><input type="hidden" name="id"/><div class="field-grid"><label>Sản phẩm<select name="productId" required data-comment-products></select></label><label>Tên người bình luận<input name="author" required/></label></div><label>Nội dung<textarea name="content" rows="4" required></textarea></label><label class="check"><input name="published" type="checkbox"/> Công khai bình luận</label><div class="form-actions"><button class="button" type="button" data-cancel-comment>Hủy</button><button class="button button-primary" type="submit">Lưu bình luận</button></div><p class="status" data-comment-status></p></form><div class="table-wrap card"><table><thead><tr><th>Người gửi</th><th>Sản phẩm</th><th>Nội dung</th><th></th></tr></thead><tbody data-comment-table></tbody></table></div></section>
      <section class="panel" data-panel="inquiries"><div class="panel-head"><div><h2>Khách liên hệ</h2><p>Nội dung khách gửi từ biểu mẫu website.</p></div></div><div class="table-wrap card"><table><thead><tr><th>Khách hàng</th><th>Dự án</th><th>Nội dung</th><th>Trạng thái</th></tr></thead><tbody data-inquiry-table></tbody></table></div></section>
    </div>
  </section>
</AdminLayout>
<script>
  import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from 'firebase/auth';
  import { addDoc, collection, deleteDoc, doc, getDocs, setDoc, serverTimestamp, updateDoc } from 'firebase/firestore';
  import { getDownloadURL, ref, uploadBytes } from 'firebase/storage';
  import { adminLoginEmail, firebaseConfigured } from '../../lib/firebase';
  import { getFirebaseServices } from '../../lib/firebase-admin';

  type RecordData = { id: string; [key: string]: any };
  const $ = <T extends Element>(selector:string) => document.querySelector<T>(selector);
  const $$ = <T extends Element>(selector:string) => [...document.querySelectorAll<T>(selector)];
  const loginShell = $('[data-login-shell]') as HTMLElement; const adminShell = $('[data-admin-shell]') as HTMLElement; const loginForm = $('[data-login-form]') as HTMLFormElement; const loginStatus = $('[data-login-status]') as HTMLElement;
  let products: RecordData[] = [], comments: RecordData[] = [], inquiries: RecordData[] = [], stats: RecordData[] = [];
  const escapeHtml = (value='') => String(value).replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char] || char));
  const getForm = (form:HTMLFormElement) => Object.fromEntries(new FormData(form));
  const money = (value:number,currency='USD') => new Intl.NumberFormat('vi-VN',{style:'currency',currency}).format(value||0);
  const showNotice = (message:string) => { const notice = $('[data-admin-notice]') as HTMLElement; notice.textContent=message; notice.hidden=!message; };
  function switchTab(name:string) { $$<HTMLElement>('[data-panel]').forEach(x=>x.classList.toggle('active',x.dataset.panel===name)); $$<HTMLButtonElement>('[data-tab]').forEach(x=>x.classList.toggle('active',x.dataset.tab===name)); const active=$<HTMLElement>(`[data-tab="${name}"]`); const title=$('[data-section-title]') as HTMLElement; if(title&&active) title.textContent=active.textContent||''; }
  $$<HTMLButtonElement>('[data-tab]').forEach(button=>button.addEventListener('click',()=>switchTab(button.dataset.tab||'overview')));
  function render() {
    ($('[data-total-products]') as HTMLElement).textContent=String(products.length); const totalViews=stats.reduce((n,x)=>n+(x.views||0),0); const totalClicks=stats.reduce((n,x)=>n+(x.clicks||0),0); ($('[data-total-views]') as HTMLElement).textContent=totalViews.toLocaleString('vi-VN'); ($('[data-total-clicks]') as HTMLElement).textContent=totalClicks.toLocaleString('vi-VN'); ($('[data-total-inquiries]') as HTMLElement).textContent=String(inquiries.filter(x=>x.status!=='done').length);
    ($('[data-stats-table]') as HTMLElement).innerHTML=products.map(p=>{const s:RecordData=stats.find(x=>x.id===p.id)||{id:p.id};const rate=s.views?((s.clicks||0)/s.views*100).toFixed(1):'0.0';return `<tr><td>${escapeHtml(p.title)}</td><td>${s.views||0}</td><td>${s.clicks||0}</td><td>${rate}%</td></tr>`}).join('')||'<tr><td colspan="4">Chưa có dữ liệu.</td></tr>';
    ($('[data-product-table]') as HTMLElement).innerHTML=products.map(p=>`<tr><td><b>${escapeHtml(p.title)}</b><small>${escapeHtml(p.category||'')}</small></td><td>${money(p.price,p.currency)}</td><td><span class="state">${p.published?'Công khai':'Bản nháp'}</span></td><td class="actions"><button data-edit-product="${p.id}">Sửa</button><button class="danger" data-delete-product="${p.id}">Xóa</button></td></tr>`).join('')||'<tr><td colspan="4">Chưa có sản phẩm.</td></tr>';
    ($('[data-comment-products]') as HTMLSelectElement).innerHTML='<option value="">Chọn sản phẩm</option>'+products.map(p=>`<option value="${p.id}">${escapeHtml(p.title)}</option>`).join('');
    ($('[data-comment-table]') as HTMLElement).innerHTML=comments.map(c=>`<tr><td>${escapeHtml(c.author)}</td><td>${escapeHtml(products.find(p=>p.id===c.productId)?.title||'—')}</td><td>${escapeHtml(c.content)}</td><td class="actions"><button data-edit-comment="${c.id}">Sửa</button><button class="danger" data-delete-comment="${c.id}">Xóa</button></td></tr>`).join('')||'<tr><td colspan="4">Chưa có bình luận.</td></tr>';
    ($('[data-inquiry-table]') as HTMLElement).innerHTML=inquiries.map(i=>`<tr><td><b>${escapeHtml(i.name)}</b><small>${escapeHtml(i.email)}</small></td><td>${escapeHtml(i.projectType||'—')}</td><td>${escapeHtml(i.description||'')}</td><td><button data-toggle-inquiry="${i.id}" class="state">${i.status==='done'?'Đã xử lý':'Mới'}</button></td></tr>`).join('')||'<tr><td colspan="4">Chưa có liên hệ.</td></tr>';
    bindRows();
  }
  async function loadData(){const {db}=getFirebaseServices();const [p,c,i,s]=await Promise.all(['products','comments','inquiries','stats'].map(name=>getDocs(collection(db,name))));products=p.docs.map(x=>({id:x.id,...x.data()} as RecordData));comments=c.docs.map(x=>({id:x.id,...x.data()} as RecordData));inquiries=i.docs.map(x=>({id:x.id,...x.data()} as RecordData)).sort((a,b)=>(b.createdAt?.seconds||0)-(a.createdAt?.seconds||0));stats=s.docs.map(x=>({id:x.id,...x.data()} as RecordData));render();}
  function openProduct(item?:RecordData){const form=$('[data-product-form]') as HTMLFormElement;form.reset();form.hidden=false;if(item){for(const [key,value] of Object.entries(item)){const field=form.elements.namedItem(key) as HTMLInputElement|null;if(field){if(field.type==='checkbox')field.checked=Boolean(value);else if(field.type!=='file')field.value=String(value??'');}}}form.scrollIntoView({behavior:'smooth'});}
  function openComment(item?:RecordData){const form=$('[data-comment-form]') as HTMLFormElement;form.reset();form.hidden=false;if(item){for(const [key,value] of Object.entries(item)){const field=form.elements.namedItem(key) as HTMLInputElement|null;if(field){if(field.type==='checkbox')field.checked=Boolean(value);else field.value=String(value??'');}}}form.scrollIntoView({behavior:'smooth'});}
  function bindRows(){ $$<HTMLButtonElement>('[data-edit-product]').forEach(b=>b.onclick=()=>openProduct(products.find(x=>x.id===b.dataset.editProduct))); $$<HTMLButtonElement>('[data-delete-product]').forEach(b=>b.onclick=async()=>{if(confirm('Xóa sản phẩm này?')){const {db}=getFirebaseServices();await deleteDoc(doc(db,'products',b.dataset.deleteProduct!));await loadData();}}); $$<HTMLButtonElement>('[data-edit-comment]').forEach(b=>b.onclick=()=>openComment(comments.find(x=>x.id===b.dataset.editComment))); $$<HTMLButtonElement>('[data-delete-comment]').forEach(b=>b.onclick=async()=>{if(confirm('Xóa bình luận này?')){const {db}=getFirebaseServices();await deleteDoc(doc(db,'comments',b.dataset.deleteComment!));await loadData();}}); $$<HTMLButtonElement>('[data-toggle-inquiry]').forEach(b=>b.onclick=async()=>{const item=inquiries.find(x=>x.id===b.dataset.toggleInquiry);if(item){const {db}=getFirebaseServices();await updateDoc(doc(db,'inquiries',item.id),{status:item.status==='done'?'new':'done'});await loadData();}}); }
  $('[data-new-product]')?.addEventListener('click',()=>openProduct()); $('[data-cancel-product]')?.addEventListener('click',()=>{($('[data-product-form]') as HTMLFormElement).hidden=true}); $('[data-new-comment]')?.addEventListener('click',()=>openComment()); $('[data-cancel-comment]')?.addEventListener('click',()=>{($('[data-comment-form]') as HTMLFormElement).hidden=true});
  ($('[data-product-form]') as HTMLFormElement).addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const status=$('[data-product-status]') as HTMLElement;status.textContent='Đang lưu…';try{const data=getForm(form) as any;const id=String(data.id||'');const file=(form.elements.namedItem('image') as HTMLInputElement).files?.[0];const {db,storage}=getFirebaseServices();let imageUrl=String(data.imageUrl||'');if(file){const uploadRef=ref(storage,`product-images/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]/g,'-')}`);await uploadBytes(uploadRef,file);imageUrl=await getDownloadURL(uploadRef);}const payload={title:String(data.title),slug:String(data.slug),price:Number(data.price),currency:String(data.currency),category:String(data.category||''),referenceGame:String(data.referenceGame||''),order:Number(data.order||0),description:String(data.description),imageUrl,ctaLabel:String(data.ctaLabel||''),ctaUrl:String(data.ctaUrl||''),published:data.published==='on',updatedAt:serverTimestamp()};if(id)await setDoc(doc(db,'products',id),payload,{merge:true});else await addDoc(collection(db,'products'),{...payload,createdAt:serverTimestamp()});status.textContent='Đã lưu sản phẩm.';form.hidden=true;await loadData();}catch(error){status.textContent='Không thể lưu. Kiểm tra quyền quản trị và cấu hình Firebase.';}});
  ($('[data-comment-form]') as HTMLFormElement).addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const status=$('[data-comment-status]') as HTMLElement;try{const data=getForm(form) as any;const id=String(data.id||'');const {db}=getFirebaseServices();const payload={productId:String(data.productId),author:String(data.author),content:String(data.content),published:data.published==='on',updatedAt:serverTimestamp()};if(id)await setDoc(doc(db,'comments',id),payload,{merge:true});else await addDoc(collection(db,'comments'),{...payload,createdAt:serverTimestamp()});status.textContent='Đã lưu bình luận.';form.hidden=true;await loadData();}catch{status.textContent='Không thể lưu bình luận.';}});
  if(!firebaseConfigured){loginStatus.textContent='Hệ thống quản trị đang chờ cấu hình Firebase.';}else{const {auth}=getFirebaseServices();loginForm.addEventListener('submit',async event=>{event.preventDefault();loginStatus.textContent='Đang đăng nhập…';const data=getForm(loginForm);const username=String(data.username||'').trim();const email=username.toLowerCase()==='admin'?adminLoginEmail:username;try{if(!email)throw new Error();await signInWithEmailAndPassword(auth,email,String(data.password||''));}catch{loginStatus.textContent='Tài khoản hoặc mật khẩu không đúng.';}});onAuthStateChanged(auth,async user=>{loginShell.hidden=Boolean(user);adminShell.hidden=!user;if(user){showNotice('');try{await loadData();}catch{showNotice('Tài khoản đã đăng nhập nhưng chưa có quyền quản trị. Hãy thêm UID này vào collection admins trong Firebase.');}}});$('[data-signout]')?.addEventListener('click',()=>signOut(auth));}
</script>
<style>.login-shell{min-height:100vh;display:grid;place-items:center;padding:1.5rem}.login-card{width:min(440px,100%);padding:2rem}.back{display:block;margin-bottom:2rem;color:#9eabbb;font-size:.85rem}.mark{display:grid;place-items:center;width:3rem;height:3rem;border-radius:.8rem;background:linear-gradient(135deg,#3b82f6,#7c5cfc);font-weight:800}.login-card h1{margin:.3rem 0;font-size:2rem}.login-card label,.editor label{display:grid;gap:.4rem;margin-top:1rem;font-size:.85rem;font-weight:650}.login-card input,.editor input,.editor select,.editor textarea{width:100%;padding:.75rem .85rem;border:1px solid var(--line);border-radius:.55rem;background:#080e16;color:#fff}.login-card .button{width:100%;margin-top:1.25rem;border:0}.status{min-height:1.4rem;color:#afbbca;font-size:.82rem}.admin-shell{min-height:100vh;background:#080c12}.admin-shell aside{position:fixed;inset:0 auto 0 0;width:240px;display:flex;flex-direction:column;padding:1.5rem;border-right:1px solid var(--line);background:#0b111a}.admin-shell aside>div{display:grid;margin-bottom:2.5rem}.admin-shell aside span{color:#778495;font-size:.75rem}.admin-shell nav{display:grid;gap:.4rem}.admin-shell nav button,.signout{padding:.75rem;border:0;border-radius:.5rem;background:transparent;color:#9da9b9;text-align:left;cursor:pointer}.admin-shell nav button:hover,.admin-shell nav button.active{background:#172031;color:#fff}.signout{margin-top:auto}.workspace{margin-left:240px;padding:2rem clamp(1rem,4vw,3rem)}.workspace>header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem}.workspace header h1{margin:0;font-size:2rem}.workspace header p{margin:0 0 .5rem}.workspace header a{color:#aebdff}.notice{padding:1rem;border:1px solid #8a6925;border-radius:.6rem;background:#291f0c;color:#f1d58c}.panel{display:none}.panel.active{display:block}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.metric-grid article{padding:1.2rem;border:1px solid var(--line);border-radius:.75rem;background:#111824}.metric-grid span,.metric-grid strong{display:block}.metric-grid span{color:#8e9aab;font-size:.8rem}.metric-grid strong{margin-top:.3rem;font-size:2rem}.activity{margin-top:1.3rem;padding:1.2rem}.activity h2{margin:0 0 1rem}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}.panel-head h2,.panel-head p{margin:0}.panel-head p{color:#8e9aab}.table-wrap{overflow:auto}.table-wrap.card{padding:.4rem 1rem}table{width:100%;border-collapse:collapse}th,td{padding:.9rem .7rem;border-bottom:1px solid var(--line);text-align:left;font-size:.85rem}th{color:#8e9aab;font-size:.75rem;text-transform:uppercase}td small{display:block;color:#7d8999}.actions{white-space:nowrap}.actions button,.state{padding:.35rem .55rem;border:1px solid var(--line);border-radius:.4rem;background:#111824;color:#dce3ed;cursor:pointer}.actions .danger{color:#ff9b9b}.editor{margin-bottom:1.2rem;padding:1.4rem}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.editor .check{display:flex;align-items:center}.editor .check input{width:auto}.form-actions{display:flex;justify-content:flex-end;gap:.7rem;margin-top:1.2rem}.form-actions .button{width:auto}.admin-shell[hidden],.login-shell[hidden],.editor[hidden]{display:none}@media(max-width:760px){.admin-shell aside{position:static;width:auto}.admin-shell aside>div{margin-bottom:1rem}.admin-shell nav{grid-template-columns:repeat(2,1fr)}.signout{margin-top:1rem}.workspace{margin-left:0}.metric-grid{grid-template-columns:repeat(2,1fr)}.field-grid{grid-template-columns:1fr}.workspace>header,.panel-head{align-items:flex-start;flex-direction:column}.panel-head .button{width:100%}}</style>

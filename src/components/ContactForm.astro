---
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '';
---
<form class="contact-form card" data-contact-form data-endpoint={endpoint} novalidate>
  <div class="field-grid">
    <label>Name <span>*</span><input name="name" autocomplete="name" required placeholder="Your name" /></label>
    <label>Email <span>*</span><input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
  </div>
  <label>Company / Organization<input name="company" autocomplete="organization" placeholder="Your company" /></label>
  <div class="field-grid">
    <label>Project Type <span>*</span><select name="projectType" required><option value="">Select a project type</option>{['Full Game Development','Prototype','Gameplay Programming','Bug Fixing','Optimization','Game Reskin','UI Implementation','WebGL Project','Ongoing Support','Other'].map(x=><option>{x}</option>)}</select></label>
    <label>Budget Range<select name="budget"><option>Not sure yet</option>{['Under $1,000','$1,000 - $3,000','$3,000 - $10,000','$10,000+','Prefer to discuss'].map(x=><option>{x}</option>)}</select></label>
  </div>
  <label>Timeline<select name="timeline"><option value="">Select a timeline</option>{['ASAP','1 month','1-3 months','3-6 months','Flexible'].map(x=><option>{x}</option>)}</select></label>
  <label>Project Description <span>*</span><textarea name="description" rows="6" required minlength="20" placeholder="Tell us what you are building, where the project stands, and what support you need."></textarea></label>
  <button class="button button-primary" type="submit">Send Project Brief <span aria-hidden="true">→</span></button>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>
<script>
  const form = document.querySelector('[data-contact-form]');
  const status = document.querySelector('[data-form-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    if (!form.checkValidity()) { form.reportValidity(); status.textContent = 'Please complete the required fields.'; return; }
    const endpoint = form.dataset.endpoint;
    if (!endpoint) { status.textContent = 'The form backend has not been configured yet. Please email hello@gamecorelabs.com.'; return; }
    const button = form.querySelector('button');
    if (button) button.setAttribute('disabled',''); status.textContent = 'Sending your project brief…';
    try {
      const response = await fetch(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(Object.fromEntries(new FormData(form))) });
      if (!response.ok) throw new Error('Request failed');
      form.reset(); status.textContent = 'Thanks — your project brief has been sent.';
    } catch { status.textContent = 'We could not send the form. Please email hello@gamecorelabs.com instead.'; }
    finally { if (button) button.removeAttribute('disabled'); }
  });
</script>
<style>.contact-form{padding:clamp(1.2rem,4vw,2rem);display:grid;gap:1rem}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}label{display:grid;gap:.4rem;color:#dfe5ee;font-size:.82rem;font-weight:650}label span{color:#9e8aff}input,select,textarea{width:100%;border:1px solid var(--line);border-radius:.52rem;background:#0a111b;color:#f5f7fa;padding:.82rem .9rem;outline:none}input:focus,select:focus,textarea:focus{border-color:#7259ed;box-shadow:0 0 0 3px rgba(124,92,252,.12)}textarea{resize:vertical}.contact-form .button{width:100%;border:0}.form-status{min-height:1.5rem;margin:0;color:#b6c3d4;text-align:center;font-size:.85rem}@media(max-width:600px){.field-grid{grid-template-columns:1fr}}</style>

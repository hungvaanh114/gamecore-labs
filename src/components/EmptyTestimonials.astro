---
const { lang = 'en' } = Astro.props;
---
<div class="empty card"><div aria-hidden="true">“</div><h2>{lang === 'vi' ? 'Câu chuyện khách hàng sẽ sớm được cập nhật.' : 'Client stories are on the way.'}</h2><p>{lang === 'vi' ? 'Chúng tôi đang chuẩn bị các câu chuyện và đánh giá từ khách hàng.' : "We're currently preparing client stories and testimonials."}</p></div>
<style>.empty{text-align:center;padding:clamp(2rem,6vw,5rem)}.empty div{color:#8e7aff;font-family:Georgia,serif;font-size:4rem;line-height:1}.empty h2{margin:.3rem 0;font-size:1.6rem}.empty p{margin:.5rem 0 0;color:#9ca8b8}</style>

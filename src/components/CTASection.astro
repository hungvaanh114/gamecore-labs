---
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';
const { lang = 'en', title = lang === 'vi' ? 'Cùng Nhau Tạo Nên Một Trò Chơi Tuyệt Vời.' : "Let's Build Something Great.", text = lang === 'vi' ? 'Bạn có ý tưởng game hoặc dự án đang cần hỗ trợ phát triển? Hãy trao đổi với chúng tôi.' : 'Have a game idea or an existing project that needs development support? Let’s talk.' } = Astro.props;
---
<section class="section-tight"><div class="container"><div class="cta"><div><p class="eyebrow">{lang === 'vi' ? 'BẮT ĐẦU DỰ ÁN' : 'START A PROJECT'}</p><h2>{title}</h2><p>{text}</p></div><div class="actions"><PrimaryButton href={lang === 'vi' ? '/vi/contact' : '/contact'}>{lang === 'vi' ? 'Bắt Đầu Dự Án' : 'Start Your Project'}</PrimaryButton><SecondaryButton href={lang === 'vi' ? '/vi/contact' : '/contact'}>{lang === 'vi' ? 'Liên Hệ' : 'Contact Us'}</SecondaryButton></div></div></div></section>
<style>.cta{position:relative;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding:clamp(2rem,5vw,4rem);border:1px solid transparent;border-radius:1rem;background:linear-gradient(#0c121c,#0c121c) padding-box,linear-gradient(115deg,rgba(59,130,246,.8),rgba(124,92,252,.2),rgba(124,92,252,.75)) border-box;overflow:hidden}.cta::after{content:"";position:absolute;right:8%;top:-6rem;width:18rem;height:12rem;background:#5a3fea;filter:blur(95px);opacity:.18}.cta h2{margin:0;font-size:clamp(2rem,4vw,3.5rem);line-height:1.05;letter-spacing:-.05em}.cta p:not(.eyebrow){max-width:37rem;margin:.9rem 0 0;color:#a9b4c3}.actions{position:relative;z-index:1;display:flex;gap:.75rem;flex-shrink:0}@media(max-width:800px){.cta{align-items:stretch;flex-direction:column}.actions{width:100%}}@media(max-width:520px){.actions{flex-direction:column}}</style>

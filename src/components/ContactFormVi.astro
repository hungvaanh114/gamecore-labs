---
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '';
---
<form class="contact-form card" data-contact-form data-endpoint={endpoint} data-lang="vi" novalidate>
  <div class="field-grid">
    <label>Họ và tên <span>*</span><input name="name" autocomplete="name" required placeholder="Tên của bạn" /></label>
    <label>Email <span>*</span><input name="email" type="email" autocomplete="email" required placeholder="ban@example.com" /></label>
  </div>
  <label>Công ty / Tổ chức<input name="company" autocomplete="organization" placeholder="Tên công ty" /></label>
  <div class="field-grid">
    <label>Loại dự án <span>*</span><select name="projectType" required><option value="">Chọn loại dự án</option>{['Phát triển game hoàn chỉnh','Làm nguyên mẫu','Lập trình gameplay','Sửa lỗi','Tối ưu','Reskin game','Triển khai UI','Dự án WebGL','Hỗ trợ dài hạn','Khác'].map(x=><option>{x}</option>)}</select></label>
    <label>Ngân sách tham khảo<select name="budget"><option>Chưa xác định</option>{['Dưới 1 triệu VNĐ','1 - 5 triệu VNĐ','5 - 10 triệu VNĐ','10 - 30 triệu VNĐ','30 - 100 triệu VNĐ','Trên 100 triệu VNĐ','Muốn trao đổi thêm'].map(x=><option>{x}</option>)}</select></label>
  </div>
  <div class="field-grid">
    <label>Thể loại game<select name="genre"><option value="">Chọn thể loại</option>{['Hành động','Phiêu lưu','Kinh dị','Đua xe','Platform','Chiến thuật','Casual','Mô phỏng','Giáo dục','Khác'].map(x=><option>{x}</option>)}</select></label>
    <label>Game / sản phẩm tham khảo<select name="referenceProduct"><option value="">Chọn game tham khảo</option>{['Neon Drifter','Tiny World','Lost Signals','Orbit Defense','Pixel Chef','Shadow Protocol','Sản phẩm khác / chưa xác định'].map(x=><option>{x}</option>)}</select></label>
  </div>
  <label>Game khác bạn muốn tham khảo<input name="referenceGame" placeholder="Ví dụ: tên game hoặc đường dẫn tham khảo" /></label>
  <label>Thời gian<select name="timeline"><option value="">Chọn thời gian dự kiến</option>{['Sớm nhất có thể','1 tháng','1-3 tháng','3-6 tháng','Linh hoạt'].map(x=><option>{x}</option>)}</select></label>
  <label>Mô tả dự án <span>*</span><textarea name="description" rows="6" required minlength="20" placeholder="Hãy cho chúng tôi biết bạn đang xây dựng gì, dự án đang ở giai đoạn nào và bạn cần hỗ trợ gì."></textarea></label>
  <button class="button button-primary" type="submit">Gửi thông tin dự án <span aria-hidden="true">→</span></button>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>
<script>
  import { getFunctions, httpsCallable } from 'firebase/functions';
  import { firebaseConfigured, getFirebaseApp } from '../lib/firebase';
  const form = document.querySelector('[data-contact-form]');
  const status = document.querySelector('[data-form-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    if (!form.checkValidity()) { form.reportValidity(); status.textContent = 'Vui lòng điền đầy đủ các trường bắt buộc.'; return; }
    const endpoint = form.dataset.endpoint;
    if (!firebaseConfigured && !endpoint) { status.textContent = 'Hệ thống nhận biểu mẫu chưa được cấu hình. Vui lòng gửi email tới hello@gamecorelabs.com.'; return; }
    const button = form.querySelector('button');
    if (button) button.setAttribute('disabled',''); status.textContent = 'Đang gửi thông tin dự án…';
    try {
      const payload = { ...Object.fromEntries(new FormData(form)), language:'vi' };
      if (firebaseConfigured) await httpsCallable(getFunctions(getFirebaseApp(), 'asia-southeast1'), 'submitInquiry')(payload);
      else { const response = await fetch(endpoint!, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) }); if (!response.ok) throw new Error('Request failed'); }
      form.reset(); status.textContent = 'Cảm ơn bạn — thông tin dự án đã được gửi.';
    } catch { status.textContent = 'Không thể gửi biểu mẫu. Vui lòng gửi email tới hello@gamecorelabs.com.'; }
    finally { if (button) button.removeAttribute('disabled'); }
  });
</script>
<style>.contact-form{padding:clamp(1.2rem,4vw,2rem);display:grid;gap:1rem}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}label{display:grid;gap:.4rem;color:#dfe5ee;font-size:.82rem;font-weight:650}label span{color:#9e8aff}input,select,textarea{width:100%;border:1px solid var(--line);border-radius:.52rem;background:#0a111b;color:#f5f7fa;padding:.82rem .9rem;outline:none}input:focus,select:focus,textarea:focus{border-color:#7259ed;box-shadow:0 0 0 3px rgba(124,92,252,.12)}textarea{resize:vertical}.contact-form .button{width:100%;border:0}.form-status{min-height:1.5rem;margin:0;color:#b6c3d4;text-align:center;font-size:.85rem}@media(max-width:600px){.field-grid{grid-template-columns:1fr}}</style>

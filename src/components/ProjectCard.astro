---
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';
const { project } = Astro.props;
const filters = [project.platform[0], project.genre.includes('2D') ? '2D' : '3D', project.status.includes('Prototype') ? 'Prototype' : 'Demo'].join(' ');
---
<article class="project card card-hover" data-project data-filters={filters}>
  <a href={withBase(`/work/${project.slug}/`)} aria-label={`View ${project.title} demo concept`}>
    <div class="image-wrap"><img src={withBase(project.coverImage)} alt={`${project.title} demo concept artwork`} width="720" height="450" loading="lazy" /><span class="status">{project.status}</span></div>
    <div class="content"><div><h3>{project.title}</h3><p>{project.platform.join(' / ')} · {project.genre}</p></div><span class="arrow"><Icon name="arrow" size={17} /></span><p class="description">{project.shortDescription}</p></div>
  </a>
</article>
<style>.project{overflow:hidden}.image-wrap{position:relative;aspect-ratio:16/10;overflow:hidden;background:#111827}.image-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.project:hover img{transform:scale(1.035)}.status{position:absolute;left:.8rem;top:.8rem;padding:.3rem .55rem;border:1px solid rgba(255,255,255,.18);border-radius:.4rem;background:rgba(5,8,14,.78);backdrop-filter:blur(8px);font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.content{display:grid;grid-template-columns:1fr auto;align-items:center;gap:.75rem;padding:1.1rem}.content h3{margin:0;font-size:1.05rem}.content p{margin:.1rem 0 0;color:#929daf;font-size:.78rem}.arrow{display:grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:50%;border:1px solid var(--line);color:#cbd6e6}.description{grid-column:1/-1!important;font-size:.88rem!important;line-height:1.55}</style>

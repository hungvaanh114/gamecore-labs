---
import PrimaryButton from './PrimaryButton.astro';
const { lang = 'en' } = Astro.props;
const models = lang === 'vi' ? [
  {title:'Phạm Vi Cố Định',copy:'Phù hợp với dự án có yêu cầu rõ ràng.',features:['Phạm vi rõ ràng','Hạng mục bàn giao thống nhất','Tiến độ thống nhất']},
  {title:'Sprint Chuyên Biệt',copy:'Phù hợp với nguyên mẫu và phát triển tính năng nhanh.',features:['Giai đoạn phát triển tập trung','Ưu tiên linh hoạt','Lặp nhanh'],featured:true},
  {title:'Hợp Tác Dài Hạn',copy:'Phù hợp với nhu cầu phát triển liên tục.',features:['Hỗ trợ phát triển định kỳ','Bảo trì','Cải tiến liên tục']}
] : [
  {title:'Fixed Scope',copy:'Best for clearly defined projects.',features:['Clear scope','Agreed deliverables','Agreed timeline']},
  {title:'Dedicated Sprint',copy:'Best for prototypes and fast feature development.',features:['Focused development period','Flexible priorities','Rapid iteration'],featured:true},
  {title:'Retainer',copy:'Best for ongoing development.',features:['Recurring development support','Maintenance','Continuous improvements']}
];
---
<div class="grid-3 engagement">{models.map((model) => <article class:list={['card','model',{featured:model.featured}]}>{model.featured && <span class="recommended">{lang === 'vi' ? 'Lặp nhanh' : 'Fast iteration'}</span>}<h3>{model.title}</h3><p>{model.copy}</p><ul class="list-check">{model.features.map(item => <li>{item}</li>)}</ul><PrimaryButton href={lang === 'vi' ? '/vi/contact' : '/contact'}>{lang === 'vi' ? 'Trao Đổi Dự Án' : 'Discuss Your Project'}</PrimaryButton></article>)}</div>
<style>.model{position:relative;padding:1.6rem;display:flex;flex-direction:column;min-height:22rem}.model.featured{border-color:#7258ee;box-shadow:0 0 45px rgba(81,62,190,.14)}.recommended{position:absolute;right:1rem;top:1rem;padding:.25rem .55rem;border-radius:999px;background:rgba(124,92,252,.16);color:#b8aaff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.model h3{margin:.35rem 0 .45rem;font-size:1.35rem}.model>p{margin:0;color:#9ca8b8}.model ul{margin-bottom:1.6rem}.model :global(.button){margin-top:auto;width:100%}</style>

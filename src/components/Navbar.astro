---
import Logo from './Logo.astro';
import PrimaryButton from './PrimaryButton.astro';
import { localizedPath, localeAlternatePath, type Locale } from '../utils/paths';
const { lang = 'en' } = Astro.props as { lang?: Locale };
const path = Astro.url.pathname;
const links = lang === 'vi'
  ? [['Trang chủ','/'],['Dịch vụ','/services'],['Dự án','/work'],['Sản phẩm','/products'],['Studio','/studio'],['Liên hệ','/contact']]
  : [['Home','/'],['Services','/services'],['Work','/work'],['Products','/products'],['Studio','/studio'],['Contact','/contact']];
const active = (href:string) => href === '/' ? path === localizedPath('/', lang) : path.startsWith(localizedPath(href, lang));
---
<header class="site-header" data-header>
  <div class="container nav-wrap">
    <Logo {lang} />
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(([label,href]) => <a href={localizedPath(href, lang)} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      <details class="language-menu"><summary>Ngôn ngữ</summary><div><a href={localeAlternatePath(path, 'vi')} lang="vi" hreflang="vi" aria-current={lang === 'vi' ? 'true' : undefined}>Tiếng Việt</a><a href={localeAlternatePath(path, 'en')} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a></div></details>
    </nav>
    <div class="nav-action"><PrimaryButton href={lang === 'vi' ? '/vi/contact' : '/contact'}>{lang === 'vi' ? 'Bắt đầu dự án' : 'Start a Project'}</PrimaryButton></div>
    <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav" data-menu-button>
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" data-mobile-nav hidden>
    <div class="container">
      {links.map(([label,href]) => <a href={localizedPath(href, lang)} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      <details class="mobile-language"><summary>Ngôn ngữ</summary><a href={localeAlternatePath(path, 'vi')} lang="vi">Tiếng Việt</a><a href={localeAlternatePath(path, 'en')} lang="en">English</a></details>
      <PrimaryButton href={lang === 'vi' ? '/vi/contact' : '/contact'}>{lang === 'vi' ? 'Bắt đầu dự án' : 'Start a Project'}</PrimaryButton>
    </div>
  </nav>
</header>
<script>
  const header = document.querySelector('[data-header]');
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-mobile-nav]');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (menu instanceof HTMLElement) menu.hidden = open;
  });
  const setHeader = () => header?.classList.toggle('scrolled', window.scrollY > 16);
  setHeader(); addEventListener('scroll', setHeader, { passive:true });
</script>
<style>
  .site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid transparent;background:rgba(7,10,15,.72);backdrop-filter:blur(18px);transition:border-color .25s,background .25s}.site-header.scrolled{border-color:var(--line);background:rgba(7,10,15,.92)}
  .nav-wrap{height:76px;display:flex;align-items:center;justify-content:space-between;gap:1.2rem}.desktop-nav{display:flex;align-items:center;gap:1.05rem;margin-left:auto}.desktop-nav>a{position:relative;color:#aab4c4;font-size:.78rem;font-weight:650}.desktop-nav>a:hover,.desktop-nav>a[aria-current=page]{color:white}.desktop-nav>a[aria-current=page]::after{content:"";position:absolute;left:0;right:0;bottom:-.55rem;height:2px;background:linear-gradient(90deg,var(--blue),var(--purple))}.language-menu{position:relative}.language-menu summary{display:flex;align-items:center;gap:.35rem;padding:.42rem .58rem;border:1px solid var(--line);border-radius:.45rem;color:#d8e0ec;font-size:.72rem;cursor:pointer;list-style:none}.language-menu summary::after{content:"⌄"}.language-menu summary::-webkit-details-marker{display:none}.language-menu>div{position:absolute;right:0;top:calc(100% + .55rem);min-width:9rem;padding:.4rem;border:1px solid var(--line);border-radius:.55rem;background:#101722;box-shadow:0 16px 35px rgba(0,0,0,.35)}.language-menu a{display:block;padding:.55rem .65rem;border-radius:.35rem;color:#aeb8c7;font-size:.78rem}.language-menu a:hover,.language-menu a[aria-current=true]{background:#1a2433;color:#fff}.nav-action :global(.button){min-height:2.55rem;padding:.65rem .8rem;font-size:.75rem}
  .menu-button{display:none;width:2.8rem;height:2.8rem;border:1px solid var(--line);border-radius:.55rem;background:#111824;align-items:center;justify-content:center;flex-direction:column;gap:5px}.menu-button span{width:18px;height:1.5px;background:white}.mobile-nav{border-top:1px solid var(--line);background:#080d14}.mobile-nav .container{display:grid;gap:.2rem;padding-block:.8rem 1.2rem}.mobile-nav a:not(.button){padding:.8rem;border-bottom:1px solid var(--line);color:#c5cfdb}.mobile-language{padding:.6rem .8rem;border-bottom:1px solid var(--line)}.mobile-language summary{color:#aebdff;font-weight:750;cursor:pointer}.mobile-language a{display:block!important;padding:.6rem 0!important;border:0!important}.mobile-nav .button{margin-top:.8rem}
  @media(max-width:800px){.desktop-nav,.nav-action{display:none}.menu-button{display:flex}}
</style>
